package org.apache.flink.contrib.streaming.state;

import org.apache.flink.api.common.typeutils.TypeSerializer;
import org.apache.flink.api.common.typeutils.base.MapSerializer;
import org.apache.flink.runtime.state.AbstractKeyedStateBackend;
import org.apache.flink.runtime.state.StateSnapshotTransformer;
import org.apache.flink.runtime.state.internal.InternalMapState;

import javax.annotation.Nonnull;

import java.io.IOException;
import java.util.ArrayList;
import java.util.Iterator;
import java.util.List;
import java.util.Map;

/**
 * An {@link InternalMapState} that uses an L1/L2 cache for its entries. Caches individual (UK, UV)
 * pairs for each Flink state key (K) and namespace (N).
 *
 * @param <K> The type of the Flink key.
 * @param <N> The type of the namespace.
 * @param <UK> The type of the user key in the map.
 * @param <UV> The type of the user value in the map.
 */
public class CachingInternalMapState<K, N, UK, UV>
        implements InternalMapState<K, N, UK, UV>,
                CachingInternalState<K, N, Map<UK, UV>, InternalMapState<K, N, UK, UV>> {

    private final InternalMapState<K, N, UK, UV> delegateState;
    private final CachingKeyedStateBackend<K> backend;
    private N currentNamespace;

    // Cache structure: Namespace -> Flink Key -> L1/L2 Caches for UserKey-UserValue pairs
    // LRUMap<Namespace, LRUMap<FlinkKey, PerKeyMapCache>>
    private final LRUMap<N, LRUMap<K, PerKeyMapCache<UK, UV, K, N>>> namespaceCaches;

    private final int l1CacheSizePerMap; // Max L1 entries (UK-UV pairs) per Flink Key/Namespace
    private final int l2CacheSizePerMap; // Max L2 entries (UK-UV pairs) per Flink Key/Namespace
    private final int maxActiveNamespaceKeyCombinations; // Max active (N,K) pairs with active
    // caches

    // Helper class to hold L1 and L2 caches for a specific Flink Key/Namespace's map entries
    private static class PerKeyMapCache<UK_C, UV_C, K_F, N_F> {
        final LRUMap<UK_C, CacheEntry<UV_C>> l1MapEntries;
        final LRUMap<UK_C, CacheEntry<UV_C>> l2MapEntries; // Should only hold clean entries

        PerKeyMapCache(
                int l1Size,
                int l2Size,
                InternalMapState<K_F, N_F, UK_C, UV_C> delegateState,
                AbstractKeyedStateBackend<K_F> backend,
                K_F currentFlinkKey,
                N_F currentNamespace) {
            this.l2MapEntries = new LRUMap<>(l2Size);
            this.l1MapEntries =
                    new LRUMap<>(
                            l1Size,
                            evictedL1Entry -> {
                                // On L1 eviction
                                UK_C evictedUK = evictedL1Entry.getKey();
                                CacheEntry<UV_C> evictedUVWrapper = evictedL1Entry.getValue();

                                if (evictedUVWrapper.isDirty()) {
                                    try {
                                        // This is tricky: need to set current Flink Key & Namespace
                                        // for the delegate state
                                        // Assuming backend.setCurrentKey and
                                        // delegateState.setCurrentNamespace are available
                                        // And then call delegateState.put(evictedUK,
                                        // evictedUVWrapper.getValue())
                                        // For now, conceptual placeholder for flushing logic:
                                        // --- Delegate Write Start ---

                                        // The backend's current key and the delegate state's
                                        // current namespace
                                        // are set before any operation. We need to preserve and
                                        // restore
                                        // the backend's current key. The delegate state's namespace
                                        // will be set by the backend before the next operation on
                                        // it.
                                        K_F originalFlinkKey = backend.getCurrentKey();

                                        backend.setCurrentKey(currentFlinkKey);
                                        delegateState.setCurrentNamespace(currentNamespace);
                                        if (evictedUVWrapper.getValue() == null) { // check if it
                                            // was a 'remove'
                                            // operation
                                            delegateState.remove(evictedUK);
                                        } else {
                                            delegateState.put(
                                                    evictedUK, evictedUVWrapper.getValue());
                                        }
                                        backend.setCurrentKey(originalFlinkKey); // Restore
                                        // backend's key
                                        // --- Delegate Write End ---
                                        // Put a clean version into L2
                                        l2MapEntries.put(
                                                evictedUK,
                                                CacheEntry.clean(evictedUVWrapper.getValue()));
                                        evictedUVWrapper.setDirty(false);
                                    } catch (Exception e) { // IOException or other exceptions from
                                        // state.update()
                                        // Consider proper error handling
                                        throw new RuntimeException(
                                                "Failed to flush L1 map entry to delegate/L2 on eviction for user key: "
                                                        + evictedUK,
                                                e);
                                    }
                                } else {
                                    // If not dirty, just move to L2
                                    l2MapEntries.put(evictedUK, evictedUVWrapper);
                                }
                            });
        }
    }

    public CachingInternalMapState(
            InternalMapState<K, N, UK, UV> delegateState,
            CachingKeyedStateBackend<K> backend,
            int l1CacheSizePerMap,
            int l2CacheSizePerMap,
            int maxActiveNamespaceKeyCombinations) {
        this.delegateState = delegateState;
        this.backend = backend;
        this.l1CacheSizePerMap = l1CacheSizePerMap;
        this.l2CacheSizePerMap = l2CacheSizePerMap;
        this.maxActiveNamespaceKeyCombinations = maxActiveNamespaceKeyCombinations; // Example, make
        // configurable
        this.namespaceCaches = new LRUMap<>(this.maxActiveNamespaceKeyCombinations);
    }

    private PerKeyMapCache<UK, UV, K, N> getOrCreatePerKeyMapCache(N namespace, K key) {
        LRUMap<K, PerKeyMapCache<UK, UV, K, N>> keyCaches =
                namespaceCaches.computeIfAbsent(
                        namespace, ns -> new LRUMap<>(maxActiveNamespaceKeyCombinations)); // This
        // inner
        // LRUMap
        // might also need a
        // size limit for
        // active keys
        return keyCaches.computeIfAbsent(
                key,
                k ->
                        new PerKeyMapCache<>(
                                l1CacheSizePerMap,
                                l2CacheSizePerMap,
                                delegateState,
                                backend,
                                k,
                                namespace));
    }

    @Override
    public UV get(UK userKey) throws Exception {
        K currentKey = backend.getCurrentKey();
        N currentNamespace = getCurrentNamespace();
        PerKeyMapCache<UK, UV, K, N> perKeyCache =
                getOrCreatePerKeyMapCache(currentNamespace, currentKey);

        CacheEntry<UV> l1Entry = perKeyCache.l1MapEntries.get(userKey);
        if (l1Entry != null) {
            return l1Entry.getValue(); // L1 Hit
        }

        CacheEntry<UV> l2Entry = perKeyCache.l2MapEntries.get(userKey);
        if (l2Entry != null) {
            perKeyCache.l2MapEntries.remove(userKey); // Remove from L2
            perKeyCache.l1MapEntries.put(userKey, l2Entry); // Promote to L1 (it's clean)
            return l2Entry.getValue(); // L2 Hit
        }

        // L1 and L2 Miss
        UV valueFromDelegate = delegateState.get(userKey);
        if (valueFromDelegate != null) { // Only cache non-null entries for now
            perKeyCache.l1MapEntries.put(userKey, CacheEntry.clean(valueFromDelegate));
        }
        return valueFromDelegate;
    }

    @Override
    public void put(UK userKey, UV userValue) throws Exception {
        K currentKey = backend.getCurrentKey();
        N currentNamespace = getCurrentNamespace();
        PerKeyMapCache<UK, UV, K, N> perKeyCache =
                getOrCreatePerKeyMapCache(currentNamespace, currentKey);

        if (userValue == null) { // Flink MapState typically removes on null value for put
            remove(userKey);
            return;
        }

        perKeyCache.l2MapEntries.remove(userKey); // Remove from L2 if present, as L1 will be
        // updated
        perKeyCache.l1MapEntries.put(userKey, CacheEntry.dirty(userValue)); // Put/update in L1,
        // mark dirty
    }

    @Override
    public void remove(UK userKey) throws Exception {
        K currentKey = backend.getCurrentKey();
        N currentNamespace = getCurrentNamespace();
        PerKeyMapCache<UK, UV, K, N> perKeyCache =
                getOrCreatePerKeyMapCache(currentNamespace, currentKey);

        perKeyCache.l2MapEntries.remove(userKey); // Remove from L2

        // To correctly reflect removal, we might need a tombstone or special handling
        // For now, just remove from L1 and ensure it's flushed as a removal
        // Option 1: Put a special "tombstone" CacheEntry marked dirty.
        // Option 2: Remove from cache and rely on flush to handle.
        // For simplicity, let's make sure a dirty null entry is put, L1 eviction should handle.
        // Or, more simply, have a specific way to mark for deletion.
        // For now: the L1 eviction logic will need to be smart about what delegateState.put(uk,
        // null) means
        // or have a separate delegateState.remove(uk) call.
        // The CacheEntry could have a state: CLEAN, DIRTY_UPDATE, DIRTY_REMOVE
        perKeyCache.l1MapEntries.put(userKey, CacheEntry.dirty(null)); // Mark as dirty with null
        // value, indicating removal
        // The eviction listener needs to handle this by calling delegateState.remove(userKey)
        // Or delegateState.put(userKey, null) if that's the contract.
        // Flink's MapState.put(key,null) is often equivalent to remove(key).
    }

    @Override
    public boolean contains(UK userKey) throws Exception {
        K currentKey = backend.getCurrentKey();
        N currentNamespace = getCurrentNamespace();
        PerKeyMapCache<UK, UV, K, N> perKeyCache =
                getOrCreatePerKeyMapCache(currentNamespace, currentKey);

        if (perKeyCache.l1MapEntries.containsKey(userKey)) {
            return perKeyCache.l1MapEntries.get(userKey).getValue() != null; // Check for tombstone
            // if null means
            // removed
        }
        if (perKeyCache.l2MapEntries.containsKey(userKey)) {
            return true; // L2 only has clean, non-null entries (by current design)
        }
        return delegateState.contains(userKey);
    }

    @Override
    public Iterable<Map.Entry<UK, UV>> entries() throws Exception {
        // Simplistic approach: Flush everything for this K,N then delegate.
        // This is inefficient but safe for a first pass.
        // A proper implementation requires a merging iterator.
        System.err.println(
                "CachingInternalMapState.entries() - flushing before delegating. For performance, implement a merging iterator.");
        flushCurrentKeyNamespaceCache();
        return delegateState.entries();
    }

    @Override
    public Iterable<UK> keys() throws Exception {
        System.err.println(
                "CachingInternalMapState.keys() - flushing before delegating. For performance, implement a merging iterator.");
        flushCurrentKeyNamespaceCache();
        return delegateState.keys();
    }

    @Override
    public Iterable<UV> values() throws Exception {
        System.err.println(
                "CachingInternalMapState.values() - flushing before delegating. For performance, implement a merging iterator.");
        flushCurrentKeyNamespaceCache();
        return delegateState.values();
    }

    @Override
    public Iterator<Map.Entry<UK, UV>> iterator() throws Exception {
        System.err.println(
                "CachingInternalMapState.iterator() - flushing before delegating. For performance, implement a merging iterator.");
        flushCurrentKeyNamespaceCache();
        return delegateState.iterator();
    }

    private void flushCurrentKeyNamespaceCache() throws Exception {
        K currentKey = backend.getCurrentKey();
        N currentNamespace = getCurrentNamespace();
        LRUMap<K, PerKeyMapCache<UK, UV, K, N>> keyCaches = namespaceCaches.get(currentNamespace);
        if (keyCaches != null) {
            PerKeyMapCache<UK, UV, K, N> perKeyCache = keyCaches.get(currentKey);
            if (perKeyCache != null) {
                List<UK> l1Keys = new ArrayList<>(perKeyCache.l1MapEntries.keySet());
                for (UK uk : l1Keys) {
                    CacheEntry<UV> entry = perKeyCache.l1MapEntries.get(uk);
                    if (entry != null && entry.isDirty()) {
                        UV value = entry.getValue();
                        // Set key and namespace for delegate state operation
                        K originalKeyForBackend = backend.getCurrentKey(); // Should be currentKey
                        // already
                        // N originalNsForDelegate = delegateState.getCurrentNamespace(); // No
                        // getter
                        backend.setCurrentKey(currentKey); // Redundant if already set, but safe
                        delegateState.setCurrentNamespace(currentNamespace);
                        try {
                            if (value == null) {
                                delegateState.remove(uk);
                            } else {
                                delegateState.put(uk, value);
                            }
                            entry.setDirty(false);
                            perKeyCache.l2MapEntries.put(uk, CacheEntry.clean(value)); // Store
                            // clean in
                            // L2
                        } finally {
                            // Restore backend's key if it was changed. Namespace on delegate is
                            // transient.
                            backend.setCurrentKey(originalKeyForBackend);
                            // Delegate namespace will be set by backend before next op.
                        }
                    }
                }
                // After explicit flush of dirty entries, remaining L1 entries (if any) are clean.
                // Move all L1 to L2 (LRU property of L2 will handle eviction if full).
                for (Map.Entry<UK, CacheEntry<UV>> l1Entry : perKeyCache.l1MapEntries.entrySet()) {
                    if (!l1Entry.getValue().isDirty()) { // only move clean entries
                        perKeyCache.l2MapEntries.put(l1Entry.getKey(), l1Entry.getValue());
                    }
                }
                perKeyCache.l1MapEntries.clear();
            }
        }
    }

    @Override
    public boolean isEmpty() throws Exception {
        // Simplistic and potentially slow, mirrors iterator logic
        System.err.println(
                "CachingInternalMapState.isEmpty() - flushing before delegating. Consider optimizing.");
        K currentKey = backend.getCurrentKey();
        N currentNamespace = getCurrentNamespace();
        PerKeyMapCache<UK, UV, K, N> perKeyCache =
                getOrCreatePerKeyMapCache(currentNamespace, currentKey);

        // Check L1, accounting for tombstones (null values)
        if (perKeyCache.l1MapEntries != null && !perKeyCache.l1MapEntries.isEmpty()) {
            for (CacheEntry<UV> entry : perKeyCache.l1MapEntries.values()) {
                if (entry.getValue() != null) {
                    return false; // Found a non-null value in L1
                }
            }
            // All L1 entries are tombstones, proceed to check L2/delegate
        }

        // Check L2 (should not contain tombstones by design)
        if (perKeyCache.l2MapEntries != null && !perKeyCache.l2MapEntries.isEmpty()) {
            return false; // Found entries in L2
        }

        // If caches are empty or only contain tombstones, flush and check delegate
        flushCurrentKeyNamespaceCache();
        return delegateState.isEmpty();
    }

    @Override
    public void clear() {
        K currentKey = backend.getCurrentKey();
        N currentNamespace = getCurrentNamespace();
        LRUMap<K, PerKeyMapCache<UK, UV, K, N>> keyCaches = namespaceCaches.get(currentNamespace);
        if (keyCaches != null) {
            PerKeyMapCache<UK, UV, K, N> perKeyCache = keyCaches.remove(currentKey);
            if (perKeyCache != null) {
                perKeyCache.l1MapEntries.clear();
                perKeyCache.l2MapEntries.clear();
            }
            if (keyCaches.isEmpty()) {
                namespaceCaches.remove(currentNamespace);
            }
        }
        delegateState.clear(); // Clear the underlying state for this K,N
    }

    @Override
    public void flushToUnderlyingState() throws IOException {
        K originalFlinkKey = backend.getCurrentKey();
        // Preserve the key that was current when this method was called.

        try {
            for (Map.Entry<N, LRUMap<K, PerKeyMapCache<UK, UV, K, N>>> nsEntry :
                    namespaceCaches.entrySet()) {
                N namespace = nsEntry.getKey();
                LRUMap<K, PerKeyMapCache<UK, UV, K, N>> keyCaches = nsEntry.getValue();

                for (Map.Entry<K, PerKeyMapCache<UK, UV, K, N>> keyEntry : keyCaches.entrySet()) {
                    K flinkKey = keyEntry.getKey(); // The specific Flink key for this cache
                    PerKeyMapCache<UK, UV, K, N> perKeyCache = keyEntry.getValue();
                    // The flushL1Entries method needs the specific key and namespace
                    flushL1Entries(perKeyCache, flinkKey, namespace); // throws Exception
                }
            }
        } catch (Exception e) { // Catch Exception from flushL1Entries
            // Wrap in IOException as per interface contract
            throw new IOException(
                    "Failed to flush state to underlying store for key: " + originalFlinkKey, e);
        } finally {
            // Restore the Flink key that was current at the beginning of this call.
            backend.setCurrentKey(originalFlinkKey);
        }
    }

    private void flushL1Entries(PerKeyMapCache<UK, UV, K, N> perKeyCache, K flinkKey, N namespace)
            throws Exception { // Ensure throws Exception

        K originalKeyForBackend = backend.getCurrentKey();
        // N originalNsForDelegate = delegateState.getCurrentNamespace(); // No getter

        backend.setCurrentKey(flinkKey); // Set context for this specific key
        delegateState.setCurrentNamespace(namespace); // Set context for this specific namespace

        try {
            // Iterate over a copy of keys to avoid ConcurrentModification if map changes
            List<UK> l1UserKeys = new ArrayList<>(perKeyCache.l1MapEntries.keySet());
            for (UK userKey : l1UserKeys) {
                CacheEntry<UV> cacheEntry = perKeyCache.l1MapEntries.get(userKey);
                if (cacheEntry != null && cacheEntry.isDirty()) {
                    UV userValue = cacheEntry.getValue();
                    if (userValue == null) {
                        delegateState.remove(userKey);
                    } else {
                        delegateState.put(userKey, userValue);
                    }
                    cacheEntry.setDirty(false); // Mark as clean
                    // Update L2 with the clean entry (or remove if value is null)
                    if (userValue != null) {
                        perKeyCache.l2MapEntries.put(userKey, CacheEntry.clean(userValue));
                    } else {
                        perKeyCache.l2MapEntries.remove(userKey);
                    }
                }
            }
            // After dirty entries are flushed and moved to L2, transfer remaining clean L1 to L2
            for (Map.Entry<UK, CacheEntry<UV>> l1Entry : perKeyCache.l1MapEntries.entrySet()) {
                if (!l1Entry.getValue().isDirty()) { // Should all be clean now if logic is right
                    perKeyCache.l2MapEntries.put(l1Entry.getKey(), l1Entry.getValue());
                }
            }
            perKeyCache.l1MapEntries.clear(); // Clear L1 after processing
        } finally {
            // Restore original key context for the backend
            backend.setCurrentKey(originalKeyForBackend);
            // Delegate namespace is transient, will be set by backend before next op
        }
    }

    @Override
    public InternalMapState<K, N, UK, UV> getDelegateState() {
        return delegateState;
    }

    @Override
    public TypeSerializer<K> getKeySerializer() {
        return delegateState.getKeySerializer();
    }

    @Override
    public TypeSerializer<N> getNamespaceSerializer() {
        return delegateState.getNamespaceSerializer();
    }

    @Override
    public TypeSerializer<Map<UK, UV>> getValueSerializer() {
        // This method is problematic for MapState as it doesn't serialize the whole map
        // at once usually.
        // Delegate methods like .get() .put() use UK, UV serializers.
        // For snapshotting, the delegate InternalMapState handles its own
        // serialization.
        // Throwing exception as direct use of this might be unintended with MapState.
        throw new UnsupportedOperationException(
                "getValueSerializer() for the whole map is not directly supported by CachingInternalMapState. Access via user key/value serializers.");
    }

    @Override
    public void setCurrentNamespace(@Nonnull N namespace) {
        this.currentNamespace = namespace;
        delegateState.setCurrentNamespace(namespace);
    }

    @Nonnull
    public N getCurrentNamespace() {
        return currentNamespace;
    }

    public TypeSerializer<UK> getUserKeySerializer() {
        TypeSerializer<Map<UK, UV>> mapSerializer = delegateState.getValueSerializer();
        if (mapSerializer instanceof MapSerializer) {
            return ((MapSerializer<UK, UV>) mapSerializer).getKeySerializer();
        }
        throw new IllegalStateException(
                "Cannot obtain user key serializer because the delegate state's value serializer is not a MapSerializer. Actual type: "
                        + (mapSerializer == null ? "null" : mapSerializer.getClass().getName()));
    }

    public TypeSerializer<UV> getUserValueSerializer() {
        TypeSerializer<Map<UK, UV>> mapSerializer = delegateState.getValueSerializer();
        if (mapSerializer instanceof MapSerializer) {
            return ((MapSerializer<UK, UV>) mapSerializer).getValueSerializer();
        }
        throw new IllegalStateException(
                "Cannot obtain user value serializer because the delegate state's value serializer is not a MapSerializer. Actual type: "
                        + (mapSerializer == null ? "null" : mapSerializer.getClass().getName()));
    }

    @Override
    public void putAll(Map<UK, UV> map) throws Exception {
        if (map == null || map.isEmpty()) {
            return;
        }
        K currentKey = backend.getCurrentKey();
        N currentNamespace = getCurrentNamespace();
        PerKeyMapCache<UK, UV, K, N> perKeyCache =
                getOrCreatePerKeyMapCache(currentNamespace, currentKey);

        for (Map.Entry<UK, UV> entry : map.entrySet()) {
            UK userKey = entry.getKey();
            UV userValue = entry.getValue();
            if (userValue == null) {
                // Semantics of putAll with null value: treat as remove for that key
                perKeyCache.l2MapEntries.remove(userKey);
                perKeyCache.l1MapEntries.put(userKey, CacheEntry.dirty(null));
            } else {
                perKeyCache.l2MapEntries.remove(userKey);
                perKeyCache.l1MapEntries.put(userKey, CacheEntry.dirty(userValue));
            }
        }
    }

    @Override
    public StateIncrementalVisitor<K, N, Map<UK, UV>> getStateIncrementalVisitor(
            int recommendedMaxNumberOfReturnedRecords) {
        // TODO: The visitor should be aware of the cache or bypass it.
        // For now, pass through to the delegate state. This might mean the visitor
        // sees a state that doesn't include unflushed cached changes.
        // Proper implementation might require a custom visitor that merges cache + delegate.
        return delegateState.getStateIncrementalVisitor(recommendedMaxNumberOfReturnedRecords);
    }

    @Override
    public StateSnapshotTransformer<Map<UK, UV>> getSnapshotTransform() {
        // This caching layer does not introduce its own snapshot transformations by default.
        // If the underlying state had a transformer, InternalMapState interface does not expose it.
        // Returning null is a common strategy if no specific transformation is applied.
        return null;
    }

    @Override
    public byte[] getSerializedValue(
            final byte[] serializedKeyAndNamespace,
            final TypeSerializer<K> safeKeySerializer,
            final TypeSerializer<N> safeNamespaceSerializer,
            final TypeSerializer<Map<UK, UV>> safeValueSerializer)
            throws Exception {
        // This method is for accessing raw state, often for tools or migration.
        // The cache might not be relevant here, or it would need to be flushed first.
        // For now, directly delegate, assuming the caller expects the underlying stored state.
        return delegateState.getSerializedValue(
                serializedKeyAndNamespace,
                safeKeySerializer,
                safeNamespaceSerializer,
                safeValueSerializer);
    }
}
